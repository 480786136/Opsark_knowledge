DATABASE_URL=sqlite:///./data/knowledge.db
# Optional internal service integration only. Local knowledge login does not use this Token.
# If enabled: >=32 random characters, NEVER issue to core or browsers.
KNOWLEDGE_SERVICE_TOKEN=
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://127.0.0.1:8002,http://127.0.0.1:5175,http://localhost:5175
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=1536
EMBEDDING_INDEX_VERSION=default-v1
# Opt-in: sends uploaded redacted sources to this model for human-reviewed drafts.
AI_REFINEMENT_ENABLED=false
AI_BASE_URL=http://127.0.0.1:8001/v1
AI_API_KEY=
AI_MODEL=
